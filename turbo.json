{
  "$schema": "https://v2-10-0.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/foundation/src/**"],
      "outputs": ["dist/**", "doc_build/**", ".wrangler/deploy/**"]
    },
    "build:dev": {
      "dependsOn": ["^build:dev"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/foundation/src/**"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@moduix/react#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "//#build:registry": {
      "cache": false
    },
    "moduix-docs#dev": {
      "dependsOn": ["@moduix/react#build"],
      "cache": false,
      "persistent": true
    },
    "moduix-docs#build": {
      "dependsOn": ["@moduix/react#build", "//#build:registry"],
      "outputs": ["doc_build/**"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["CLOUDFLARE_API_TOKEN"]
    },
    "check:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/foundation/src/**"],
      "outputs": []
    },
    "@moduix/react-tailwind#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/foundation/src/**",
        "$TURBO_ROOT$/packages/react/tests/**"
      ],
      "outputs": []
    },
    "@moduix/solid-tailwind#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/foundation/src/**",
        "$TURBO_ROOT$/packages/solid/tests/**"
      ],
      "outputs": []
    },
    "@moduix/vue-tailwind#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/foundation/src/**",
        "$TURBO_ROOT$/packages/vue/tests/**"
      ],
      "outputs": []
    },
    "@moduix/svelte-tailwind#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/foundation/src/**",
        "$TURBO_ROOT$/packages/svelte/tests/**"
      ],
      "outputs": []
    },
    "tsc:check": {
      "dependsOn": ["^tsc:check"],
      "outputs": []
    },
    "@moduix/react#tsc:check": {
      "dependsOn": ["^tsc:check", "build:dev"]
    },
    "@moduix/react-tailwind#tsc:check": {
      "dependsOn": ["^tsc:check", "build:dev"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/react/tests/**"]
    },
    "@moduix/solid#tsc:check": {
      "dependsOn": ["^tsc:check", "build:dev"]
    },
    "@moduix/solid-tailwind#tsc:check": {
      "dependsOn": ["^tsc:check", "build:dev"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/solid/tests/**"]
    },
    "@moduix/vue#tsc:check": {
      "dependsOn": ["^tsc:check", "build:dev"]
    },
    "@moduix/vue-tailwind#tsc:check": {
      "dependsOn": ["^tsc:check", "build:dev"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/vue/tests/**"]
    },
    "@moduix/svelte-tailwind#tsc:check": {
      "dependsOn": ["^tsc:check"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/svelte/tests/**"]
    },
    "moduix-docs#tsc:check": {
      "dependsOn": ["^tsc:check", "^build:dev"],
      "outputs": []
    }
  }
}