{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run fmt:check)",
      "Bash(pnpm run fmt:fix)",
      "Bash(pnpm run lint:check)",
      "Bash(pnpm run tsc:check)",
      "Bash(pnpm run test)",
      "Bash(pnpm run build:registry)",
      "Bash(pnpm run check:css-modules)",
      "Bash(pnpm run check:packages)",
      "Bash(pnpm run size)",
      "Bash(pnpm exec changeset status)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./.dev.vars*)"]
  }
}