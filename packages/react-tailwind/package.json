{
  "name": "@moduix/react-tailwind",
  "version": "0.1.0",
  "description": "Tailwind CSS implementation of the moduix React component system, built on Ark UI primitives.",
  "keywords": [
    "accessible",
    "ark-ui",
    "component-library",
    "react",
    "tailwindcss",
    "typescript",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blinks44/moduix.git",
    "directory": "packages/react-tailwind"
  },
  "files": [
    "dist/components",
    "dist/internal",
    "dist/presets",
    "dist/styles/animations.css",
    "dist/styles/borders.css",
    "dist/styles/colors.css",
    "dist/styles/opacity.css",
    "dist/styles/radius.css",
    "dist/styles/shadows.css",
    "dist/styles/sizing.css",
    "dist/styles/spacing.css",
    "dist/styles/style.css",
    "dist/styles/transforms.css",
    "dist/styles/transitions.css",
    "dist/styles/typography.css",
    "dist/styles/z-index.css",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./accordion": {
      "types": "./dist/components/accordion/index.d.ts",
      "import": "./dist/components/accordion/index.js"
    },
    "./alert": {
      "types": "./dist/components/alert/index.d.ts",
      "import": "./dist/components/alert/index.js"
    },
    "./angle-slider": {
      "types": "./dist/components/angle-slider/index.d.ts",
      "import": "./dist/components/angle-slider/index.js"
    },
    "./aspect-ratio": {
      "types": "./dist/components/aspect-ratio/index.d.ts",
      "import": "./dist/components/aspect-ratio/index.js"
    },
    "./avatar": {
      "types": "./dist/components/avatar/index.d.ts",
      "import": "./dist/components/avatar/index.js"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js"
    },
    "./bleed": {
      "types": "./dist/components/bleed/index.d.ts",
      "import": "./dist/components/bleed/index.js"
    },
    "./breadcrumbs": {
      "types": "./dist/components/breadcrumbs/index.d.ts",
      "import": "./dist/components/breadcrumbs/index.js"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js"
    },
    "./card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/components/card/index.js"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/components/checkbox/index.js"
    },
    "./carousel": {
      "types": "./dist/components/carousel/index.d.ts",
      "import": "./dist/components/carousel/index.js"
    },
    "./chart": {
      "types": "./dist/components/chart/index.d.ts",
      "import": "./dist/components/chart/index.js"
    },
    "./clipboard": {
      "types": "./dist/components/clipboard/index.d.ts",
      "import": "./dist/components/clipboard/index.js"
    },
    "./close-button": {
      "types": "./dist/components/close-button/index.d.ts",
      "import": "./dist/components/close-button/index.js"
    },
    "./collapsible": {
      "types": "./dist/components/collapsible/index.d.ts",
      "import": "./dist/components/collapsible/index.js"
    },
    "./color-picker": {
      "types": "./dist/components/color-picker/index.d.ts",
      "import": "./dist/components/color-picker/index.js"
    },
    "./menu": {
      "types": "./dist/components/menu/index.d.ts",
      "import": "./dist/components/menu/index.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner/index.d.ts",
      "import": "./dist/components/spinner/index.js"
    },
    "./style.css": "./dist/styles/style.css",
    "./presets/*": "./dist/presets/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch --no-clean",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "tsc:check": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ark-ui/react": "^5.39.1",
    "@rsbuild/core": "^2.2.3",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^1.0.0",
    "@rstest/adapter-rslib": "^0.11.12",
    "@rstest/core": "^0.11.12",
    "@tanstack/charts": "^0.16.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "@ark-ui/react": "^5.37.2",
    "@tanstack/charts": "^0.16.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@tanstack/charts": {
      "optional": true
    }
  }
}