{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "moduix-react-tailwind",
  "homepage": "https://moduix.dev",
  "items": [
    {
      "name": "init",
      "type": "registry:base",
      "title": "moduix React Tailwind init",
      "description": "Initialize shadcn for moduix React Tailwind and install shared dependencies.",
      "extends": "none",
      "config": {
        "style": "new-york",
        "rsc": false,
        "tsx": true,
        "aliases": {
          "components": "@/components",
          "ui": "@/components/ui",
          "lib": "@/lib",
          "hooks": "@/hooks",
          "utils": "@/lib/utils"
        }
      },
      "dependencies": ["@ark-ui/react", "class-variance-authority", "clsx", "tailwind-merge"],
      "registryDependencies": ["@moduix-react-tailwind/foundation"]
    },
    {
      "name": "foundation",
      "type": "registry:item",
      "title": "moduix React Tailwind core",
      "description": "Shared runtime dependencies and foundation styles for moduix Tailwind components.",
      "docs": "Import '@/lib/moduix/styles/style.css' once before Tailwind in your application stylesheet. Tailwind Preflight provides the reset layer.",
      "dependencies": ["@ark-ui/react", "clsx", "tailwind-merge"],
      "registryDependencies": ["https://moduix.dev/r/foundation/core.json"]
    },
    {
      "name": "cn",
      "type": "registry:item",
      "title": "moduix class name utility",
      "description": "Merges conditional and conflicting Tailwind class names.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/internal/cn.ts",
          "target": "@lib/moduix/cn.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "icons",
      "type": "registry:item",
      "title": "moduix icons",
      "description": "Internal icons used by moduix React Tailwind components.",
      "files": [
        {
          "path": "src/internal/icons/ui/index.ts",
          "target": "@lib/moduix/icons/ui/index.ts",
          "type": "registry:lib"
        },
        {
          "path": "src/internal/icons/ui/Icons.tsx",
          "target": "@lib/moduix/icons/ui/Icons.tsx",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "accordion",
      "type": "registry:item",
      "title": "Accordion",
      "description": "moduix React Tailwind Accordion component.",
      "dependencies": ["@ark-ui/react", "clsx", "tailwind-merge"],
      "registryDependencies": [
        "@moduix-react-tailwind/foundation",
        "@moduix-react-tailwind/cn",
        "@moduix-react-tailwind/icons"
      ],
      "files": [
        {
          "path": "src/components/accordion/Accordion.tsx",
          "target": "@components/ui/accordion/Accordion.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/components/accordion/index.ts",
          "target": "@components/ui/accordion/index.ts",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "alert",
      "type": "registry:item",
      "title": "Alert",
      "description": "moduix React Tailwind Alert component.",
      "dependencies": ["@ark-ui/react", "class-variance-authority", "clsx", "tailwind-merge"],
      "registryDependencies": ["@moduix-react-tailwind/foundation", "@moduix-react-tailwind/cn"],
      "files": [
        {
          "path": "src/components/alert/Alert.tsx",
          "target": "@components/ui/alert/Alert.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/components/alert/index.ts",
          "target": "@components/ui/alert/index.ts",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "angle-slider",
      "type": "registry:item",
      "title": "AngleSlider",
      "description": "moduix React Tailwind AngleSlider component.",
      "dependencies": ["@ark-ui/react", "clsx", "tailwind-merge"],
      "registryDependencies": ["@moduix-react-tailwind/foundation", "@moduix-react-tailwind/cn"],
      "files": [
        {
          "path": "src/components/angle-slider/AngleSlider.tsx",
          "target": "@components/ui/angle-slider/AngleSlider.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/components/angle-slider/index.ts",
          "target": "@components/ui/angle-slider/index.ts",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "aspect-ratio",
      "type": "registry:item",
      "title": "AspectRatio",
      "description": "moduix React Tailwind AspectRatio component.",
      "dependencies": ["@ark-ui/react", "clsx", "tailwind-merge"],
      "registryDependencies": ["@moduix-react-tailwind/foundation", "@moduix-react-tailwind/cn"],
      "files": [
        {
          "path": "src/components/aspect-ratio/AspectRatio.tsx",
          "target": "@components/ui/aspect-ratio/AspectRatio.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/components/aspect-ratio/index.ts",
          "target": "@components/ui/aspect-ratio/index.ts",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "avatar",
      "type": "registry:item",
      "title": "Avatar",
      "description": "moduix React Tailwind Avatar component.",
      "dependencies": ["@ark-ui/react", "class-variance-authority", "clsx", "tailwind-merge"],
      "registryDependencies": ["@moduix-react-tailwind/foundation", "@moduix-react-tailwind/cn"],
      "files": [
        {
          "path": "src/components/avatar/Avatar.tsx",
          "target": "@components/ui/avatar/Avatar.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/components/avatar/index.ts",
          "target": "@components/ui/avatar/index.ts",
          "type": "registry:component"
        }
      ]
    }
  ]
}