{
  "name": "@moduix/solid-tailwind",
  "version": "0.1.0",
  "description": "Tailwind CSS implementation of the moduix Solid component system, built on Ark UI primitives.",
  "keywords": [
    "accessible",
    "ark-ui",
    "component-library",
    "solid",
    "tailwindcss",
    "typescript",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blinks44/moduix.git",
    "directory": "packages/solid-tailwind"
  },
  "files": [
    "dist/components",
    "dist/internal",
    "dist/presets",
    "dist/styles/animations.css",
    "dist/styles/borders.css",
    "dist/styles/colors.css",
    "dist/styles/opacity.css",
    "dist/styles/radius.css",
    "dist/styles/shadows.css",
    "dist/styles/sizing.css",
    "dist/styles/spacing.css",
    "dist/styles/style.css",
    "dist/styles/transforms.css",
    "dist/styles/transitions.css",
    "dist/styles/typography.css",
    "dist/styles/z-index.css",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./accordion": {
      "types": "./dist/components/accordion/index.d.ts",
      "solid": "./dist/components/accordion/index.jsx",
      "import": "./dist/components/accordion/index.js",
      "default": "./dist/components/accordion/index.js"
    },
    "./alert": {
      "types": "./dist/components/alert/index.d.ts",
      "solid": "./dist/components/alert/index.jsx",
      "import": "./dist/components/alert/index.js",
      "default": "./dist/components/alert/index.js"
    },
    "./angle-slider": {
      "types": "./dist/components/angle-slider/index.d.ts",
      "solid": "./dist/components/angle-slider/index.jsx",
      "import": "./dist/components/angle-slider/index.js",
      "default": "./dist/components/angle-slider/index.js"
    },
    "./aspect-ratio": {
      "types": "./dist/components/aspect-ratio/index.d.ts",
      "solid": "./dist/components/aspect-ratio/index.jsx",
      "import": "./dist/components/aspect-ratio/index.js",
      "default": "./dist/components/aspect-ratio/index.js"
    },
    "./style.css": "./dist/styles/style.css",
    "./presets/*": "./dist/presets/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch --no-clean",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "tsc:check": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ark-ui/solid": "^5.39.1",
    "@rsbuild/core": "^2.2.3",
    "@rsbuild/plugin-babel": "^2.1.0",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@rslib/core": "^1.0.0",
    "@rstest/adapter-rslib": "^0.11.12",
    "@rstest/core": "^0.11.12",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.4.1",
    "happy-dom": "^20.14.0",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "@ark-ui/solid": "^5.37.2",
    "solid-js": "^1.9.0",
    "tailwindcss": "^4"
  }
}