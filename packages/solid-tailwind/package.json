{
  "name": "@moduix/solid-tailwind",
  "version": "3.1.0",
  "description": "Accessible Solid UI components built on Ark UI and styled with Tailwind CSS v4. 80+ components with the same API for React and Vue.",
  "keywords": [
    "a11y",
    "accessible",
    "ark-ui",
    "component-library",
    "shadcn",
    "shadcn-ui",
    "solid",
    "solid-components",
    "tailwind",
    "tailwind-components",
    "tailwindcss",
    "typescript",
    "ui",
    "ui-components"
  ],
  "homepage": "https://moduix.dev/",
  "bugs": {
    "url": "https://github.com/Blinks44/moduix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blinks44/moduix.git",
    "directory": "packages/solid-tailwind"
  },
  "files": [
    "dist",
    "!dist/index.*",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "solid": "./dist/components/*/index.jsx",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "solid": "./dist/locale.jsx",
      "import": "./dist/locale.js",
      "default": "./dist/locale.js"
    },
    "./style.css": "./dist/styles/style.css",
    "./presets/*": "./dist/presets/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "build:dev": "rslib --no-clean",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./style.css \"./presets/*\" \"./*\" --include-entrypoints $(cd src/components && printf \"./%s \" *)",
    "dev": "rslib --watch --no-clean",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "tsc:check": "tsc --noEmit"
  },
  "dependencies": {
    "@unpic/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-solid": "catalog:",
    "tailwind-merge": "catalog:",
    "unpic": "catalog:"
  },
  "devDependencies": {
    "@ark-ui/solid": "catalog:",
    "@internationalized/date": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-babel": "catalog:",
    "@rsbuild/plugin-solid": "catalog:",
    "@rsbuild/plugin-tailwindcss": "catalog:",
    "@rslib/core": "catalog:",
    "@rstest/adapter-rslib": "catalog:",
    "@rstest/browser": "catalog:",
    "@rstest/core": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@tanstack/charts": "catalog:",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "~7.0.2"
  },
  "peerDependencies": {
    "@ark-ui/solid": "^5.39.3",
    "@tanstack/charts": "^1.0.0",
    "solid-js": "^1.9.0",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@tanstack/charts": {
      "optional": true
    }
  }
}