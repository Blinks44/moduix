{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "moduix-foundation",
  "homepage": "https://moduix.dev",
  "items": [
    {
      "name": "core",
      "type": "registry:item",
      "title": "moduix core",
      "description": "Runtime styles and utilities required by moduix registry components.",
      "docs": "Required: import the installed style.css once in your app entry. The optional reset is a separate registry item and must be imported before style.css.",
      "files": [
        {
          "path": "src/styles/animations.css",
          "target": "@lib/moduix/styles/animations.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/borders.css",
          "target": "@lib/moduix/styles/borders.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/colors.css",
          "target": "@lib/moduix/styles/colors.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/opacity.css",
          "target": "@lib/moduix/styles/opacity.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/radius.css",
          "target": "@lib/moduix/styles/radius.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/shadows.css",
          "target": "@lib/moduix/styles/shadows.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/sizing.css",
          "target": "@lib/moduix/styles/sizing.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/spacing.css",
          "target": "@lib/moduix/styles/spacing.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/style.css",
          "target": "@lib/moduix/styles/style.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/transforms.css",
          "target": "@lib/moduix/styles/transforms.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/transitions.css",
          "target": "@lib/moduix/styles/transitions.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/typography.css",
          "target": "@lib/moduix/styles/typography.css",
          "type": "registry:file"
        },
        {
          "path": "src/styles/z-index.css",
          "target": "@lib/moduix/styles/z-index.css",
          "type": "registry:file"
        }
      ]
    },
    {
      "name": "reset",
      "type": "registry:item",
      "title": "moduix reset",
      "description": "Optional CSS reset for projects that want moduix global reset rules.",
      "docs": "Optional: import the installed reset.css before style.css in your app entry.",
      "files": [
        {
          "path": "src/styles/reset.css",
          "target": "@lib/moduix/styles/reset.css",
          "type": "registry:file"
        }
      ]
    },
    {
      "name": "theme-contrast",
      "type": "registry:theme",
      "title": "Contrast theme",
      "description": "High-clarity moduix tokens with stronger borders and focus states for technical interfaces.",
      "docs": "Import '@/lib/moduix/styles/style.css' once, then import '@/lib/moduix/presets/contrast.css'. Put data-moduix-theme=\"contrast\" on the document root.",
      "registryDependencies": ["https://moduix.dev/r/foundation/core.json"],
      "files": [
        {
          "path": "src/presets/contrast.css",
          "target": "@lib/moduix/presets/contrast.css",
          "type": "registry:file"
        }
      ]
    },
    {
      "name": "theme-dense",
      "type": "registry:theme",
      "title": "Dense theme",
      "description": "Compact moduix tokens with a structured blue palette for admin and data-heavy interfaces.",
      "docs": "Import '@/lib/moduix/styles/style.css' once, then import '@/lib/moduix/presets/dense.css'. Put data-moduix-theme=\"dense\" on the document root.",
      "registryDependencies": ["https://moduix.dev/r/foundation/core.json"],
      "files": [
        {
          "path": "src/presets/dense.css",
          "target": "@lib/moduix/presets/dense.css",
          "type": "registry:file"
        }
      ]
    },
    {
      "name": "theme-soft",
      "type": "registry:theme",
      "title": "Soft theme",
      "description": "Rounded moduix tokens with a warmer violet palette for product workflows.",
      "docs": "Import '@/lib/moduix/styles/style.css' once, then import '@/lib/moduix/presets/soft.css'. Put data-moduix-theme=\"soft\" on the document root.",
      "registryDependencies": ["https://moduix.dev/r/foundation/core.json"],
      "files": [
        {
          "path": "src/presets/soft.css",
          "target": "@lib/moduix/presets/soft.css",
          "type": "registry:file"
        }
      ]
    }
  ]
