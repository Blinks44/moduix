{
  "name": "@moduix/vue",
  "version": "3.0.1",
  "description": "Accessible Vue UI components built on Ark UI and styled with CSS Modules. 80+ components with the same API for React and Solid.",
  "keywords": [
    "a11y",
    "accessible",
    "ark-ui",
    "component-library",
    "components",
    "css-modules",
    "design-system",
    "headless",
    "shadcn",
    "shadcn-ui",
    "typescript",
    "ui",
    "ui-components",
    "vue",
    "vue-components"
  ],
  "homepage": "https://moduix.dev/",
  "bugs": {
    "url": "https://github.com/Blinks44/moduix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blinks44/moduix.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist",
    "!dist/index.*",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./style.css": "./dist/styles/style.css",
    "./reset.css": "./dist/styles/reset.css",
    "./presets/*": "./dist/presets/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "build:dev": "rslib --no-clean",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./style.css ./reset.css \"./presets/*\" \"./*\" --include-entrypoints $(cd src/components && printf \"./%s \" *) --ignore-rules internal-resolution-error",
    "dev": "rslib --watch --no-clean",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "tsc:check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@unpic/core": "catalog:",
    "clsx": "catalog:",
    "unpic": "catalog:"
  },
  "devDependencies": {
    "@ark-ui/vue": "catalog:",
    "@internationalized/date": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-vue": "catalog:",
    "@rslib/core": "catalog:",
    "@rstest/adapter-rslib": "catalog:",
    "@rstest/browser": "catalog:",
    "@rstest/core": "catalog:",
    "@tanstack/charts": "catalog:",
    "@testing-library/vue": "catalog:",
    "@types/node": "catalog:",
    "@vue/language-core": "catalog:",
    "@vue/server-renderer": "catalog:",
    "typescript": "~6.0.3",
    "unplugin-dts": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@ark-ui/vue": "^5.39.3",
    "@tanstack/charts": "^1.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/charts": {
      "optional": true
    }
  }
}