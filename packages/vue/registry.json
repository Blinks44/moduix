{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "moduix-vue",
  "homepage": "https://moduix.dev",
  "items": [
    {
      "name": "init",
      "type": "registry:base",
      "title": "moduix Vue init",
      "description": "Initialize shadcn for moduix Vue and install the shared foundation files.",
      "extends": "none",
      "config": {
        "style": "new-york",
        "rsc": false,
        "tsx": true,
        "aliases": {
          "components": "@/components",
          "ui": "@/components/ui",
          "lib": "@/lib",
          "hooks": "@/hooks",
          "utils": "@/lib/utils"
        }
      },
      "dependencies": ["@ark-ui/vue", "clsx"],
      "registryDependencies": ["@moduix-vue/foundation"]
    },
    {
      "name": "accordion",
      "type": "registry:item",
      "title": "Accordion",
      "description": "moduix Vue Accordion component.",
      "dependencies": ["@ark-ui/vue", "clsx"],
      "registryDependencies": ["@moduix-vue/foundation", "@moduix-vue/icons"],
      "files": [
        {
          "path": "src/components/accordion/Accordion.vue",
          "target": "@components/ui/accordion/Accordion.vue",
          "type": "registry:component"
        },
        {
          "path": "src/components/accordion/AccordionRootProvider.vue",
          "target": "@components/ui/accordion/AccordionRootProvider.vue",
          "type": "registry:component"
        },
        {
          "path": "src/components/accordion/AccordionItem.vue",
          "target": "@components/ui/accordion/AccordionItem.vue",
          "type": "registry:component"
        },
        {
          "path": "src/components/accordion/AccordionItemTrigger.vue",
          "target": "@components/ui/accordion/AccordionItemTrigger.vue",
          "type": "registry:component"
        },
        {
          "path": "src/components/accordion/AccordionItemIndicator.vue",
          "target": "@components/ui/accordion/AccordionItemIndicator.vue",
          "type": "registry:component"
        },
        {
          "path": "src/components/accordion/AccordionItemContent.vue",
          "target": "@components/ui/accordion/AccordionItemContent.vue",
          "type": "registry:component"
        },
        {
          "path": "src/components/accordion/AccordionItemBody.vue",
          "target": "@components/ui/accordion/AccordionItemBody.vue",
          "type": "registry:component"
        },
        {
          "path": "src/components/accordion/Accordion.module.css",
          "target": "@components/ui/accordion/Accordion.module.css",
          "type": "registry:file"
        },
        {
          "path": "src/components/accordion/index.ts",
          "target": "@components/ui/accordion/index.ts",
          "type": "registry:component"
        }
      ]
    },
