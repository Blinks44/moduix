{
  "name": "@moduix/svelte-tailwind",
  "version": "3.3.1",
  "description": "Accessible Svelte UI components built on Ark UI and styled with Tailwind CSS v4. 80+ components with the same API for React, Solid, and Vue.",
  "keywords": [
    "a11y",
    "accessible",
    "ark-ui",
    "component-library",
    "components",
    "design-system",
    "headless",
    "shadcn",
    "svelte",
    "svelte-components",
    "svelte5",
    "tailwindcss",
    "typescript",
    "ui",
    "ui-components"
  ],
  "homepage": "https://moduix.dev/",
  "bugs": {
    "url": "https://github.com/Blinks44/moduix/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blinks44/moduix.git",
    "directory": "packages/svelte-tailwind"
  },
  "files": [
    "dist",
    "!dist/index.*",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "svelte": "./dist/locale.js",
      "default": "./dist/locale.js"
    },
    "./style.css": "./dist/styles/style.css",
    "./presets/*": "./dist/presets/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svelte-package --input src && node ../../scripts/copy-foundation-styles.mjs --no-reset",
    "build:dev": "svelte-package --input src && node ../../scripts/copy-foundation-styles.mjs --no-reset",
    "check:package": "publint",
    "dev": "svelte-package --input src --watch",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "tsc:check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@lucide/svelte": "catalog:",
    "@unpic/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "unpic": "catalog:"
  },
  "devDependencies": {
    "@ark-ui/svelte": "catalog:",
    "@internationalized/date": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-svelte": "catalog:",
    "@rsbuild/plugin-tailwindcss": "catalog:",
    "@rstest/browser": "catalog:",
    "@rstest/core": "catalog:",
    "@sveltejs/package": "catalog:",
    "@tanstack/charts": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@ark-ui/svelte": "^5.25.1",
    "@tanstack/charts": "^1.1.0",
    "svelte": "^5.29.0",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@tanstack/charts": {
      "optional": true
    }
  }
}