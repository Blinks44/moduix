      "files": [
        {
          "path": "src/internal/overlayPortal.tsx",
          "target": "@lib/moduix/overlayPortal.tsx",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "foundation",
      "type": "registry:item",
      "title": "moduix Solid core",
      "description": "Shared runtime dependencies installed by every moduix registry component.",
      "dependencies": ["@ark-ui/solid", "clsx"],
      "registryDependencies": ["https://moduix.dev/r/foundation/core.json"]
    },
    {
      "name": "theme-contrast",
      "type": "registry:theme",
      "title": "Contrast theme",
      "description": "High-clarity moduix tokens with stronger borders and focus states for technical interfaces.",
      "docs": "Import '@/lib/moduix/styles/style.css' once, then import '@/lib/moduix/presets/contrast.css'. Put data-moduix-theme=\"contrast\" on the document root.",
      "registryDependencies": ["https://moduix.dev/r/foundation/theme-contrast.json"]
    },
    {
      "name": "theme-dense",
      "type": "registry:theme",
      "title": "Dense theme",
      "description": "Compact moduix tokens with a structured blue palette for admin and data-heavy interfaces.",
      "docs": "Import '@/lib/moduix/styles/style.css' once, then import '@/lib/moduix/presets/dense.css'. Put data-moduix-theme=\"dense\" on the document root.",
