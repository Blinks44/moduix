{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "moduix-solid",
  "homepage": "https://moduix.dev",
  "items": [
    {
      "name": "init",
      "type": "registry:base",
      "title": "moduix Solid init",
      "description": "Initialize shadcn for moduix Solid and install the shared foundation files.",
      "extends": "none",
      "config": {
        "style": "new-york",
        "rsc": false,
        "tsx": true,
        "aliases": {
          "components": "@/components",
          "ui": "@/components/ui",
          "lib": "@/lib",
          "hooks": "@/hooks",
          "utils": "@/lib/utils"
        }
      },
      "dependencies": ["@ark-ui/solid", "clsx"],
      "registryDependencies": ["@moduix-solid/foundation"]
    },
    {
      "name": "core",
      "type": "registry:item",
      "title": "moduix core",
      "description": "Runtime styles and utilities required by moduix registry components.",
      "docs": "Required: import the installed style.css once in your app entry. The optional reset is a separate registry item and must be imported before style.css.",
      "registryDependencies": ["https://moduix.dev/r/foundation/core.json"]
    },
    {
      "name": "reset",
      "type": "registry:item",
      "title": "moduix reset",
      "description": "Optional CSS reset for projects that want moduix global reset rules.",
      "docs": "Optional: import the installed reset.css before style.css in your app entry.",
      "registryDependencies": ["https://moduix.dev/r/foundation/reset.json"]
    },
    {
      "name": "icons",
      "type": "registry:item",
      "title": "moduix icons",
      "description": "Internal icon components required only by registry components that render them.",
      "files": [
        {
          "path": "src/internal/icons/ui/Icons.tsx",
          "target": "@lib/moduix/icons/ui/Icons.tsx",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "overlay-portal",
      "type": "registry:item",
      "title": "moduix overlay portal",
