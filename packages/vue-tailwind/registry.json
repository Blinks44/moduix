{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "moduix-vue-tailwind",
  "homepage": "https://moduix.dev",
  "items": [
    {
      "name": "init",
      "type": "registry:base",
      "title": "moduix Vue Tailwind init",
      "description": "Initialize shadcn for moduix Vue Tailwind and install shared dependencies.",
      "extends": "none",
      "config": {
        "style": "new-york",
        "rsc": false,
        "tsx": true,
        "aliases": {
          "components": "@/components",
          "ui": "@/components/ui",
          "lib": "@/lib",
          "hooks": "@/hooks",
          "utils": "@/lib/utils"
        }
      },
      "dependencies": ["@ark-ui/vue", "class-variance-authority", "clsx", "tailwind-merge"],
      "registryDependencies": ["@moduix-vue-tailwind/foundation"]
    },
