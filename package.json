{
  "name": "moduix-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:docs": "turbo run build -F moduix-docs",
    "build:react": "turbo run build -F @moduix/react",
    "build:registry": "shadcn registry validate registry/registry.json && rm -rf website/docs/public/r/react && shadcn build registry/registry.json --output website/docs/public/r/react && oxfmt",
    "check:package": "publint packages/react && attw --pack packages/react --entrypoints ./button ./locale --profile esm-only",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm run build:react && changeset publish",
    "deploy:docs": "turbo run deploy -F moduix-docs",
    "dev:docs": "turbo run dev -F moduix-docs...",
    "dev:storybook": "turbo run storybook -F @moduix/react",
    "fmt:check": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "publish:react": "pnpm --filter @moduix/react publish",
    "test": "turbo run test",
    "tsc:check": "turbo run tsc:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "shadcn": "^4.19.0",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}