{
  "name": "moduix-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:docs": "turbo run build -F moduix-docs",
    "build:react": "turbo run build -F @moduix/react",
    "build:react-tailwind": "turbo run build -F @moduix/react-tailwind",
    "build:solid": "turbo run build -F @moduix/solid",
    "build:registry": "(cd packages/foundation && shadcn registry validate registry.json) && (cd packages/react && shadcn registry validate registry.json) && (cd packages/react-tailwind && shadcn registry validate registry.json) && (cd packages/solid && shadcn registry validate registry.json) && rm -rf website/docs/public/r/foundation website/docs/public/r/react website/docs/public/r/react-tailwind website/docs/public/r/solid && (cd packages/foundation && shadcn build registry.json --output ../../website/docs/public/r/foundation) && (cd packages/react && shadcn build registry.json --output ../../website/docs/public/r/react) && (cd packages/react-tailwind && shadcn build registry.json --output ../../website/docs/public/r/react-tailwind) && (cd packages/solid && shadcn build registry.json --output ../../website/docs/public/r/solid) && oxfmt",
    "check:package": "publint packages/react && attw --pack packages/react --entrypoints ./button ./locale --profile esm-only",
    "check:package:react-tailwind": "publint packages/react-tailwind && attw --pack packages/react-tailwind --entrypoints ./accordion --profile esm-only",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm run build:react && changeset publish",
    "deploy:docs": "turbo run deploy -F moduix-docs",
    "dev:docs": "turbo run dev -F moduix-docs...",
    "dev:playgrounds": "pnpm --parallel --filter @moduix/playground-react --filter @moduix/playground-react-tailwind --filter @moduix/playground-solid storybook",
    "dev:playground:react": "pnpm --filter @moduix/playground-react storybook",
    "dev:playground:react-tailwind": "pnpm --filter @moduix/playground-react-tailwind storybook",
    "dev:playground:solid": "pnpm --filter @moduix/playground-solid storybook",
    "dev:solid": "turbo run dev -F @moduix/solid",
    "dev:storybook": "pnpm run dev:playgrounds",
    "fmt:check": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "publish:react": "pnpm --filter @moduix/react publish",
    "publish:react-tailwind": "pnpm --filter @moduix/react-tailwind publish",
    "test": "turbo run test",
    "tsc:check": "turbo run tsc:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "publint": "^0.3.24",
    "shadcn": "^4.21.0",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}