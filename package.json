{
  "name": "moduix-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:docs": "turbo run build -F moduix-docs",
    "build:packages": "turbo run build -F './packages/*'",
    "build:registry": "pnpm run registry:validate && pnpm run registry:clean && pnpm run registry:build",
    "check:packages": "turbo run check:package -F './packages/*'",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "pnpm run build:packages && pnpm run check:packages && changeset publish",
    "deploy:docs": "turbo run deploy -F moduix-docs",
    "dev:docs": "turbo run dev -F moduix-docs -F @moduix/react",
    "dev:playgrounds": "pnpm --parallel --filter './playgrounds/*' storybook",
    "dev:playground:react": "pnpm --filter @moduix/playground-react storybook",
    "dev:playground:react-tailwind": "pnpm --filter @moduix/playground-react-tailwind storybook",
    "dev:playground:solid": "pnpm --filter @moduix/playground-solid storybook",
    "dev:playground:solid-tailwind": "pnpm --filter @moduix/playground-solid-tailwind storybook",
    "dev:playground:vue": "pnpm --filter @moduix/playground-vue storybook",
    "dev:playground:vue-tailwind": "pnpm --filter @moduix/playground-vue-tailwind storybook",
    "fmt:check": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "registry:build": "for p in packages/*; do [ -f \"$p/registry.json\" ] || continue; (cd \"$p\" && shadcn build registry.json --output \"../../website/docs/public/r/${p#packages/}\") || exit 1; done && (cd website && shadcn build registry.json --output docs/public/r/blocks)",
    "registry:clean": "rm -rf website/docs/public/r",
    "registry:validate": "for p in packages/*; do [ -f \"$p/registry.json\" ] || continue; (cd \"$p\" && shadcn registry validate registry.json) || exit 1; done && (cd website && shadcn registry validate registry.json)",
    "test": "turbo run test",
    "tsc:check": "turbo run tsc:check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@vue/language-server": "^3.3.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "catalog:",
    "publint": "^0.3.24",
    "shadcn": "^4.21.0",
    "turbo": "^2.10.13",
    "typescript": "~6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}