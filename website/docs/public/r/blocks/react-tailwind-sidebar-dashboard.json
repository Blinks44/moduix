{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "react-tailwind-sidebar-dashboard",
  "title": "Sidebar Dashboard",
  "description": "React sidebar-dashboard block with Tailwind components and shared CSS Module layout.",
  "dependencies": ["lucide-react"],
  "registryDependencies": [
    "https://moduix.dev/r/react-tailwind/button.json",
    "https://moduix.dev/r/react-tailwind/card.json",
    "https://moduix.dev/r/react-tailwind/collapsible.json",
    "https://moduix.dev/r/react-tailwind/menu.json",
    "https://moduix.dev/r/react-tailwind/sidebar.json"
  ],
  "files": [
    {
      "path": "src/components/blocks/sidebar-dashboard.tsx",
      "content": "'use client';\n\nimport { ChevronsUpDown, FileText, FolderOpen, Gauge, LogOut, Settings, Users } from 'lucide-react';\nimport { Button } from '@/registry/react/ui/button';\nimport { Card, CardBody } from '@/registry/react/ui/card';\nimport {\n  Collapsible,\n  CollapsibleTrigger,\n  CollapsibleIndicator,\n  CollapsibleContent,\n} from '@/registry/react/ui/collapsible';\nimport {\n  Menu,\n  MenuTrigger,\n  MenuIndicator,\n  MenuPositioner,\n  MenuContent,\n  MenuViewport,\n  MenuItem,\n  MenuSeparator,\n  MenuItemText,\n  MenuItemTextContent,\n  MenuItemTextIcon,\n  MenuItemTextLabel,\n} from '@/registry/react/ui/menu';\nimport {\n  Sidebar,\n  SidebarPanel,\n  SidebarInset,\n  SidebarResizeTrigger,\n  SidebarTrigger,\n  SidebarLabel,\n  SidebarHeader,\n  SidebarContent,\n  SidebarExpandedContent,\n  SidebarCollapsedContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupLabel,\n  SidebarNavigationList,\n  SidebarNavigationItem,\n  SidebarTooltip,\n  SidebarNavigationButton,\n  SidebarNavigationBadge,\n  SidebarNavigationSubList,\n  SidebarNavigationSubItem,\n  SidebarNavigationSubButton,\n} from '@/registry/react/ui/sidebar';\nimport styles from './sidebar-dashboard.module.css';\n\nexport function SidebarDashboard() {\n  return (\n    <Sidebar className={styles.root}>\n      <SidebarPanel>\n        <SidebarHeader>\n          <a className={styles.brand} href=\"#overview\">\n            <span className={styles.brandMark} data-sidebar-icon>\n              M\n            </span>\n            <SidebarLabel>Moduix</SidebarLabel>\n          </a>\n        </SidebarHeader>\n\n        <SidebarContent>\n          <SidebarGroup>\n            <SidebarGroupLabel>Workspace</SidebarGroupLabel>\n            <SidebarNavigationList>\n              <SidebarNavigationItem>\n                <SidebarTooltip content=\"Overview\">\n                  <SidebarNavigationButton asChild active>\n                    <a href=\"#overview\">\n                      <Gauge />\n                      <SidebarLabel>Overview</SidebarLabel>\n                    </a>\n                  </SidebarNavigationButton>\n                </SidebarTooltip>\n              </SidebarNavigationItem>\n              <SidebarNavigationItem>\n                <SidebarExpandedContent>\n                  <Collapsible defaultOpen>\n                    <SidebarTooltip content=\"Projects\">\n                      <CollapsibleTrigger asChild>\n                        <SidebarNavigationButton>\n                          <FolderOpen />\n                          <SidebarLabel>Projects</SidebarLabel>\n                          <CollapsibleIndicator />\n                        </SidebarNavigationButton>\n                      </CollapsibleTrigger>\n                    </SidebarTooltip>\n                    <CollapsibleContent>\n                      <SidebarNavigationSubList>\n                        <SidebarNavigationSubItem>\n                          <SidebarNavigationSubButton href=\"#website\">\n                            Website\n                          </SidebarNavigationSubButton>\n                        </SidebarNavigationSubItem>\n                        <SidebarNavigationSubItem>\n                          <SidebarNavigationSubButton href=\"#mobile-app\">\n                            Mobile app\n                          </SidebarNavigationSubButton>\n                          <SidebarNavigationBadge>8</SidebarNavigationBadge>\n                        </SidebarNavigationSubItem>\n                      </SidebarNavigationSubList>\n                    </CollapsibleContent>\n                  </Collapsible>\n                </SidebarExpandedContent>\n                <SidebarCollapsedContent>\n                  <Menu positioning={{ placement: 'right-start', gutter: 8 }}>\n                    <MenuTrigger asChild>\n                      <SidebarNavigationButton aria-label=\"Open projects\" title=\"Projects\">\n                        <FolderOpen />\n                      </SidebarNavigationButton>\n                    </MenuTrigger>\n                    <MenuPositioner>\n                      <MenuContent>\n                        <MenuViewport>\n                          <MenuItem value=\"website\" asChild>\n                            <a href=\"#website\">Website</a>\n                          </MenuItem>\n                          <MenuItem value=\"mobile-app\" asChild>\n                            <a href=\"#mobile-app\">Mobile app</a>\n                          </MenuItem>\n                        </MenuViewport>\n                      </MenuContent>\n                    </MenuPositioner>\n                  </Menu>\n                </SidebarCollapsedContent>\n              </SidebarNavigationItem>\n              <SidebarNavigationItem>\n                <SidebarTooltip content=\"Documents\">\n                  <SidebarNavigationButton asChild>\n                    <a href=\"#documents\">\n                      <FileText />\n                      <SidebarLabel>Documents</SidebarLabel>\n                    </a>\n                  </SidebarNavigationButton>\n                </SidebarTooltip>\n              </SidebarNavigationItem>\n            </SidebarNavigationList>\n          </SidebarGroup>\n\n          <SidebarGroup>\n            <SidebarGroupLabel>Manage</SidebarGroupLabel>\n            <SidebarNavigationList>\n              <SidebarNavigationItem>\n                <SidebarTooltip content=\"Team\">\n                  <SidebarNavigationButton asChild>\n                    <a href=\"#team\">\n                      <Users />\n                      <SidebarLabel>Team</SidebarLabel>\n                    </a>\n                  </SidebarNavigationButton>\n                </SidebarTooltip>\n              </SidebarNavigationItem>\n              <SidebarNavigationItem>\n                <SidebarTooltip content=\"Settings\">\n                  <SidebarNavigationButton asChild>\n                    <a href=\"#settings\">\n                      <Settings />\n                      <SidebarLabel>Settings</SidebarLabel>\n                    </a>\n                  </SidebarNavigationButton>\n                </SidebarTooltip>\n              </SidebarNavigationItem>\n            </SidebarNavigationList>\n          </SidebarGroup>\n        </SidebarContent>\n\n        <SidebarFooter>\n          <SidebarNavigationList>\n            <SidebarNavigationItem>\n              <Menu positioning={{ placement: 'right-end', gutter: 8, flip: false }}>\n                <MenuTrigger asChild>\n                  <SidebarNavigationButton\n                    size=\"lg\"\n                    aria-label=\"Open workspace menu\"\n                    title=\"Workspace\"\n                  >\n                    <span className={styles.workspaceMark} data-sidebar-icon>\n                      AC\n                    </span>\n                    <SidebarLabel>Acme Inc.</SidebarLabel>\n                    <MenuIndicator>\n                      <ChevronsUpDown />\n                    </MenuIndicator>\n                  </SidebarNavigationButton>\n                </MenuTrigger>\n                <MenuPositioner>\n                  <MenuContent className={styles.workspaceMenu}>\n                    <MenuViewport>\n                      <MenuItem value=\"workspace-settings\">\n                        <MenuItemText>\n                          <MenuItemTextContent>\n                            <MenuItemTextIcon>\n                              <Settings />\n                            </MenuItemTextIcon>\n                            <MenuItemTextLabel>Workspace settings</MenuItemTextLabel>\n                          </MenuItemTextContent>\n                        </MenuItemText>\n                      </MenuItem>\n                      <MenuItem value=\"manage-members\">\n                        <MenuItemText>\n                          <MenuItemTextContent>\n                            <MenuItemTextIcon>\n                              <Users />\n                            </MenuItemTextIcon>\n                            <MenuItemTextLabel>Manage members</MenuItemTextLabel>\n                          </MenuItemTextContent>\n                        </MenuItemText>\n                      </MenuItem>\n                      <MenuSeparator />\n                      <MenuItem value=\"sign-out\" tone=\"destructive\">\n                        <MenuItemText>\n                          <MenuItemTextContent>\n                            <MenuItemTextIcon>\n                              <LogOut />\n                            </MenuItemTextIcon>\n                            <MenuItemTextLabel>Sign out</MenuItemTextLabel>\n                          </MenuItemTextContent>\n                        </MenuItemText>\n                      </MenuItem>\n                    </MenuViewport>\n                  </MenuContent>\n                </MenuPositioner>\n              </Menu>\n            </SidebarNavigationItem>\n          </SidebarNavigationList>\n        </SidebarFooter>\n      </SidebarPanel>\n\n      <SidebarResizeTrigger />\n      <SidebarTrigger />\n\n      <SidebarInset>\n        <main className={styles.content} id=\"overview\">\n          <header className={styles.header}>\n            <div>\n              <p className={styles.eyebrow}>Workspace</p>\n              <h1>Overview</h1>\n              <p className={styles.description}>\n                Everything your team is working on, in one place.\n              </p>\n            </div>\n            <Button size=\"sm\">New project</Button>\n          </header>\n\n          <section className={styles.metrics} id=\"projects\" aria-label=\"Workspace summary\">\n            <Card size=\"sm\">\n              <CardBody className={styles.metric}>\n                <span>Active projects</span>\n                <strong>12</strong>\n              </CardBody>\n            </Card>\n            <Card size=\"sm\">\n              <CardBody className={styles.metric}>\n                <span>Team members</span>\n                <strong>8</strong>\n              </CardBody>\n            </Card>\n            <Card size=\"sm\">\n              <CardBody className={styles.metric}>\n                <span>Open tasks</span>\n                <strong>24</strong>\n              </CardBody>\n            </Card>\n          </section>\n\n          <Card className={styles.activity} size=\"sm\">\n            <CardBody className={styles.activityBody}>\n              <strong>Keep moving</strong>\n              <span>Create a project to start sharing work with your team.</span>\n            </CardBody>\n          </Card>\n        </main>\n      </SidebarInset>\n    </Sidebar>\n  );\n}",
      "type": "registry:component",
      "target": "@components/blocks/sidebar-dashboard/sidebar-dashboard.tsx"
    },
    {
      "path": "src/components/blocks/sidebar-dashboard.module.css",
      "content": ".root {\n  width: min(100%, 64rem);\n  height: 38rem;\n  min-height: 30rem;\n  border-radius: var(--moduix-radius-lg);\n  box-shadow: var(--moduix-shadow-sm);\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: var(--moduix-spacing-2);\n  min-width: 0;\n  color: inherit;\n  font-weight: var(--moduix-weight-semibold);\n  text-decoration: none;\n}\n\n.brandMark {\n  display: grid;\n  flex: none;\n  place-items: center;\n  width: var(--moduix-size-sm);\n  height: var(--moduix-size-sm);\n  border-radius: var(--moduix-radius-sm);\n  background-color: var(--moduix-color-primary);\n  color: var(--moduix-color-primary-foreground);\n  font-size: var(--moduix-text-xs);\n}\n\n.workspaceMark {\n  display: grid;\n  flex: none;\n  place-items: center;\n  width: var(--moduix-size-sm);\n  height: var(--moduix-size-sm);\n  border-radius: var(--moduix-radius-sm);\n  background-color: var(--moduix-color-muted);\n  color: var(--moduix-color-foreground);\n  font-size: var(--moduix-text-xs);\n  font-weight: var(--moduix-weight-semibold);\n}\n\n.workspaceMenu {\n  width: 11rem;\n  min-width: 11rem;\n  max-width: 11rem;\n}\n\n.content {\n  display: grid;\n  gap: var(--moduix-spacing-6);\n  min-height: 100%;\n  padding: var(--moduix-spacing-6);\n}\n\n.header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--moduix-spacing-4);\n}\n\n.header h1,\n.header p {\n  margin: 0;\n}\n\n.header h1 {\n  margin-block-start: var(--moduix-spacing-1);\n  font-size: var(--moduix-text-2xl);\n  line-height: var(--moduix-line-height-text-2xl);\n}\n\n.eyebrow {\n  color: var(--moduix-color-muted-foreground);\n  font-size: var(--moduix-text-sm);\n  font-weight: var(--moduix-weight-medium);\n}\n\n.header .description {\n  margin-block-start: var(--moduix-spacing-2);\n  color: var(--moduix-color-muted-foreground);\n}\n\n.metrics {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: var(--moduix-spacing-4);\n}\n\n.metric {\n  display: grid;\n  gap: var(--moduix-spacing-2);\n  justify-items: center;\n  text-align: center;\n}\n\n.metric span {\n  color: var(--moduix-color-muted-foreground);\n  font-size: var(--moduix-text-sm);\n}\n\n.metric strong {\n  font-size: var(--moduix-text-3xl);\n  line-height: var(--moduix-line-height-text-3xl);\n}\n\n.activity {\n  align-self: start;\n}\n\n.activityBody {\n  display: grid;\n  gap: var(--moduix-spacing-1);\n}\n\n.activityBody strong {\n  color: var(--moduix-color-foreground);\n}\n\n@media (width < 40rem) {\n  .content {\n    padding: var(--moduix-spacing-4);\n  }\n\n  .metrics {\n    grid-template-columns: 1fr;\n  }\n}",
      "type": "registry:file",
      "target": "@components/blocks/sidebar-dashboard/sidebar-dashboard.module.css"
    }
  ],
  "type": "registry:block"
}