{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "vue-sidebar-dashboard",
  "title": "Sidebar dashboard",
  "description": "Dashboard with a resizable sidebar, nested navigation, and a workspace menu.",
  "dependencies": ["@lucide/vue"],
  "registryDependencies": [
    "https://moduix.dev/r/vue/button.json",
    "https://moduix.dev/r/vue/card.json",
    "https://moduix.dev/r/vue/collapsible.json",
    "https://moduix.dev/r/vue/menu.json",
    "https://moduix.dev/r/vue/sidebar.json"
  ],
  "files": [
    {
      "path": "snippets/blocks/vue/sidebar-dashboard.vue",
      "content": "<script setup lang=\"ts\">\nimport { ChevronsUpDown, FileText, FolderOpen, Gauge, Settings, Users } from '@lucide/vue';\nimport { Button } from '@/components/ui/button';\nimport { Card, CardBody } from '@/components/ui/card';\nimport {\n  Collapsible,\n  CollapsibleTrigger,\n  CollapsibleIndicator,\n  CollapsibleContent,\n} from '@/components/ui/collapsible';\nimport {\n  Menu,\n  MenuTrigger,\n  MenuIndicator,\n  MenuPositioner,\n  MenuContent,\n  MenuViewport,\n  MenuItem,\n  MenuItemText,\n  MenuItemTextContent,\n  MenuItemTextIcon,\n  MenuItemTextLabel,\n} from '@/components/ui/menu';\nimport {\n  Sidebar,\n  SidebarPanel,\n  SidebarInset,\n  SidebarResizeTrigger,\n  SidebarTrigger,\n  SidebarLabel,\n  SidebarHeader,\n  SidebarContent,\n  SidebarFooter,\n  SidebarGroup,\n  SidebarGroupLabel,\n  SidebarNavigationList,\n  SidebarNavigationItem,\n  SidebarTooltip,\n  SidebarNavigationButton,\n  SidebarNavigationSubList,\n  SidebarNavigationSubItem,\n  SidebarNavigationSubButton,\n} from '@/components/ui/sidebar';\nimport styles from './sidebar-dashboard.module.css';\nconst manageItems = [\n  { label: 'Team', href: '#team', icon: Users },\n  { label: 'Settings', href: '#settings', icon: Settings },\n];\n</script>\n<template>\n  <Sidebar :class=\"styles.root\">\n    <SidebarPanel>\n      <SidebarHeader\n        ><a :class=\"styles.brand\" href=\"#overview\"\n          ><span :class=\"styles.brandMark\" data-sidebar-icon>M</span\n          ><SidebarLabel>Moduix</SidebarLabel></a\n        ></SidebarHeader\n      >\n      <SidebarContent>\n        <SidebarGroup>\n          <SidebarGroupLabel>Workspace</SidebarGroupLabel>\n          <SidebarNavigationList>\n            <SidebarNavigationItem\n              ><SidebarTooltip content=\"Overview\"\n                ><SidebarNavigationButton active as-child\n                  ><a href=\"#overview\"\n                    ><Gauge /><SidebarLabel>Overview</SidebarLabel></a\n                  ></SidebarNavigationButton\n                ></SidebarTooltip\n              ></SidebarNavigationItem\n            >\n            <SidebarNavigationItem>\n              <Collapsible default-open>\n                <SidebarTooltip content=\"Projects\"\n                  ><CollapsibleTrigger as-child\n                    ><SidebarNavigationButton\n                      ><FolderOpen /><SidebarLabel>Projects</SidebarLabel\n                      ><CollapsibleIndicator /></SidebarNavigationButton></CollapsibleTrigger\n                ></SidebarTooltip>\n                <CollapsibleContent\n                  ><SidebarNavigationSubList>\n                    <SidebarNavigationSubItem\n                      ><SidebarNavigationSubButton as-child\n                        ><a href=\"#website\">Website</a></SidebarNavigationSubButton\n                      ></SidebarNavigationSubItem\n                    >\n                    <SidebarNavigationSubItem\n                      ><SidebarNavigationSubButton as-child\n                        ><a href=\"#mobile-app\">Mobile app</a></SidebarNavigationSubButton\n                      ></SidebarNavigationSubItem\n                    >\n                  </SidebarNavigationSubList></CollapsibleContent\n                >\n              </Collapsible>\n            </SidebarNavigationItem>\n            <SidebarNavigationItem\n              ><SidebarTooltip content=\"Documents\"\n                ><SidebarNavigationButton as-child\n                  ><a href=\"#documents\"\n                    ><FileText /><SidebarLabel>Documents</SidebarLabel></a\n                  ></SidebarNavigationButton\n                ></SidebarTooltip\n              ></SidebarNavigationItem\n            >\n          </SidebarNavigationList>\n        </SidebarGroup>\n        <SidebarGroup>\n          <SidebarGroupLabel>Manage</SidebarGroupLabel>\n          <SidebarNavigationList>\n            <SidebarNavigationItem v-for=\"item in manageItems\" :key=\"item.href\"\n              ><SidebarTooltip :content=\"item.label\"\n                ><SidebarNavigationButton as-child\n                  ><a :href=\"item.href\"\n                    ><component :is=\"item.icon\" /><SidebarLabel>{{ item.label }}</SidebarLabel></a\n                  ></SidebarNavigationButton\n                ></SidebarTooltip\n              ></SidebarNavigationItem\n            >\n          </SidebarNavigationList>\n        </SidebarGroup>\n      </SidebarContent>\n      <SidebarFooter\n        ><SidebarNavigationList\n          ><SidebarNavigationItem>\n            <Menu :positioning=\"{ placement: 'right-end', gutter: 8, flip: false }\">\n              <MenuTrigger as-child\n                ><SidebarNavigationButton\n                  size=\"lg\"\n                  aria-label=\"Open workspace menu\"\n                  title=\"Workspace\"\n                  ><span :class=\"styles.workspaceMark\" data-sidebar-icon>AC</span\n                  ><SidebarLabel>Acme Inc.</SidebarLabel\n                  ><MenuIndicator><ChevronsUpDown /></MenuIndicator></SidebarNavigationButton\n              ></MenuTrigger>\n              <MenuPositioner\n                ><MenuContent :class=\"styles.workspaceMenu\"\n                  ><MenuViewport>\n                    <MenuItem value=\"workspace-settings\"\n                      ><MenuItemText\n                        ><MenuItemTextContent\n                          ><MenuItemTextIcon><Settings /></MenuItemTextIcon\n                          ><MenuItemTextLabel\n                            >Workspace settings</MenuItemTextLabel\n                          ></MenuItemTextContent\n                        ></MenuItemText\n                      ></MenuItem\n                    >\n                    <MenuItem value=\"manage-members\"\n                      ><MenuItemText\n                        ><MenuItemTextContent\n                          ><MenuItemTextIcon><Users /></MenuItemTextIcon\n                          ><MenuItemTextLabel\n                            >Manage members</MenuItemTextLabel\n                          ></MenuItemTextContent\n                        ></MenuItemText\n                      ></MenuItem\n                    >\n                  </MenuViewport></MenuContent\n                ></MenuPositioner\n              >\n            </Menu>\n          </SidebarNavigationItem></SidebarNavigationList\n        ></SidebarFooter\n      >\n    </SidebarPanel>\n    <SidebarResizeTrigger /><SidebarTrigger />\n    <SidebarInset>\n      <main :class=\"styles.content\" id=\"overview\">\n        <header :class=\"styles.header\">\n          <div>\n            <p :class=\"styles.eyebrow\">Workspace</p>\n            <h1>Overview</h1>\n            <p :class=\"styles.description\">Everything your team is working on, in one place.</p>\n          </div>\n          <Button size=\"sm\">New project</Button>\n        </header>\n        <section :class=\"styles.metrics\" id=\"projects\" aria-label=\"Workspace summary\">\n          <Card size=\"sm\"\n            ><CardBody :class=\"styles.metric\"\n              ><span>Active projects</span><strong>12</strong></CardBody\n            ></Card\n          >\n          <Card size=\"sm\"\n            ><CardBody :class=\"styles.metric\"\n              ><span>Team members</span><strong>8</strong></CardBody\n            ></Card\n          >\n          <Card size=\"sm\"\n            ><CardBody :class=\"styles.metric\"\n              ><span>Open tasks</span><strong>24</strong></CardBody\n            ></Card\n          >\n        </section>\n        <Card :class=\"styles.activity\" size=\"sm\"\n          ><CardBody :class=\"styles.activityBody\"\n            ><strong>Keep moving</strong\n            ><span>Create a project to start sharing work with your team.</span></CardBody\n          ></Card\n        >\n      </main>\n    </SidebarInset>\n  </Sidebar>\n</template>",
      "type": "registry:component",
      "target": "@components/blocks/sidebar-dashboard/sidebar-dashboard.vue"
    },
    {
      "path": "src/components/blocks/sidebar-dashboard.module.css",
      "content": ".root {\n  --moduix-sidebar-width: min(100%, 64rem);\n  --moduix-sidebar-height: 38rem;\n\n  width: var(--moduix-sidebar-width);\n  height: var(--moduix-sidebar-height);\n  min-height: 30rem;\n  border-radius: var(--moduix-radius-lg);\n  box-shadow: var(--moduix-shadow-sm);\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: var(--moduix-spacing-2);\n  min-width: 0;\n  color: inherit;\n  font-weight: var(--moduix-weight-semibold);\n  text-decoration: none;\n}\n\n.brandMark {\n  display: grid;\n  flex: none;\n  place-items: center;\n  width: var(--moduix-size-sm);\n  height: var(--moduix-size-sm);\n  border-radius: var(--moduix-radius-sm);\n  background-color: var(--moduix-color-primary);\n  color: var(--moduix-color-primary-foreground);\n  font-size: var(--moduix-text-xs);\n}\n\n.workspaceMark {\n  display: grid;\n  flex: none;\n  place-items: center;\n  width: var(--moduix-size-sm);\n  height: var(--moduix-size-sm);\n  border-radius: var(--moduix-radius-sm);\n  background-color: var(--moduix-color-muted);\n  color: var(--moduix-color-foreground);\n  font-size: var(--moduix-text-xs);\n  font-weight: var(--moduix-weight-semibold);\n}\n\n.workspaceMenu {\n  width: 11rem;\n  min-width: 11rem;\n  max-width: 11rem;\n}\n\n.content {\n  display: grid;\n  gap: var(--moduix-spacing-6);\n  min-height: 100%;\n  padding: var(--moduix-spacing-6);\n}\n\n.header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--moduix-spacing-4);\n}\n\n.header h1,\n.header p {\n  margin: 0;\n}\n\n.header h1 {\n  margin-block-start: var(--moduix-spacing-1);\n  font-size: var(--moduix-text-2xl);\n  line-height: var(--moduix-line-height-text-2xl);\n}\n\n.eyebrow {\n  color: var(--moduix-color-muted-foreground);\n  font-size: var(--moduix-text-sm);\n  font-weight: var(--moduix-weight-medium);\n}\n\n.header .description {\n  margin-block-start: var(--moduix-spacing-2);\n  color: var(--moduix-color-muted-foreground);\n}\n\n.metrics {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: var(--moduix-spacing-4);\n}\n\n.metric {\n  display: grid;\n  gap: var(--moduix-spacing-2);\n  justify-items: center;\n  text-align: center;\n}\n\n.metric span {\n  color: var(--moduix-color-muted-foreground);\n  font-size: var(--moduix-text-sm);\n}\n\n.metric strong {\n  font-size: var(--moduix-text-3xl);\n  line-height: var(--moduix-line-height-text-3xl);\n}\n\n.activity {\n  align-self: start;\n}\n\n.activityBody {\n  display: grid;\n  gap: var(--moduix-spacing-1);\n}\n\n.activityBody strong {\n  color: var(--moduix-color-foreground);\n}\n\n@media (width < 40rem) {\n  .content {\n    padding: var(--moduix-spacing-4);\n  }\n\n  .metrics {\n    grid-template-columns: 1fr;\n  }\n}",
      "type": "registry:file",
      "target": "@components/blocks/sidebar-dashboard/sidebar-dashboard.module.css"
    }
  ],
  "type": "registry:block"
}