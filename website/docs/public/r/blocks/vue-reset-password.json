{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "vue-reset-password",
  "title": "Reset password",
  "description": "Password reset form with a confirmation field.",
  "registryDependencies": [
    "https://moduix.dev/r/vue/button.json",
    "https://moduix.dev/r/vue/card.json",
    "https://moduix.dev/r/vue/field.json",
    "https://moduix.dev/r/vue/input.json"
  ],
  "files": [
    {
      "path": "snippets/blocks/vue/reset-password.vue",
      "content": "<script setup lang=\"ts\">\nimport { Button } from '@/components/ui/button';\nimport {\n  Card,\n  CardBody,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from '@/components/ui/card';\nimport { Field, FieldLabel } from '@/components/ui/field';\nimport { Input } from '@/components/ui/input';\nimport styles from './reset-password-form.module.css';\n\nconst emit = defineEmits<{ submit: [event: Event] }>();\n</script>\n\n<template>\n  <Card :class=\"styles.root\">\n    <CardHeader :class=\"styles.header\">\n      <CardTitle>Create a new password</CardTitle>\n      <CardDescription>Choose a strong password you don&apos;t use elsewhere.</CardDescription>\n    </CardHeader>\n\n    <CardBody>\n      <form :class=\"styles.stack\" @submit=\"emit('submit', $event)\">\n        <Field required>\n          <FieldLabel>New password</FieldLabel>\n          <Input name=\"password\" type=\"password\" autocomplete=\"new-password\" />\n        </Field>\n\n        <Field required>\n          <FieldLabel>Confirm new password</FieldLabel>\n          <Input name=\"confirm-password\" type=\"password\" autocomplete=\"new-password\" />\n        </Field>\n\n        <Button type=\"submit\" :class=\"styles.submit\"> Reset password </Button>\n      </form>\n    </CardBody>\n\n    <CardFooter :class=\"styles.footer\">\n      <p>\n        Remembered your password?\n        <a :class=\"styles.link\" href=\"/sign-in\"> Sign in </a>\n      </p>\n    </CardFooter>\n  </Card>\n</template>",
      "type": "registry:component",
      "target": "@components/blocks/reset-password/reset-password.vue"
    },
    {
      "path": "src/components/blocks/reset-password/reset-password-form.module.css",
      "content": ".root {\n  width: min(100%, 26rem);\n}\n\n.header {\n  display: flex;\n  flex-direction: column;\n  gap: var(--moduix-spacing-2);\n  text-align: center;\n}\n\n.stack {\n  display: grid;\n  gap: var(--moduix-spacing-4);\n}\n\n.link {\n  color: var(--moduix-color-primary);\n  font-size: var(--moduix-text-sm);\n  font-weight: var(--moduix-weight-medium);\n  text-underline-offset: 0.2em;\n\n  &:hover {\n    color: var(--moduix-color-foreground);\n    text-decoration: underline;\n  }\n\n  &:focus-visible {\n    outline: var(--moduix-border-width-md) solid var(--moduix-color-ring);\n    outline-offset: var(--moduix-border-width-sm);\n    border-radius: var(--moduix-radius-xs);\n  }\n}\n\n.submit {\n  width: 100%;\n}\n\n.footer {\n  justify-content: center;\n  text-align: center;\n}\n\n.footer p {\n  margin: 0;\n  color: var(--moduix-color-muted-foreground);\n  font-size: var(--moduix-text-sm);\n}",
      "type": "registry:file",
      "target": "@components/blocks/reset-password/reset-password-form.module.css"
    }
  ],
  "type": "registry:block"
}